{
  "name": "isotopes-backend",
  "version": "1.0.0",
  "description": "ISOTOPES - SIH26044 Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:memory-db": "node scripts/startMemoryDatabase.js",
    "seed": "node seed.js",
    "dev:list-users": "node scripts/listUsers.js",
    "dev:reset-user": "node scripts/resetUser.js",
    "test": "jest --detectOpenHandles --forceExit",
    "test:unit": "jest __tests__/unit --detectOpenHandles --forceExit",
    "test:api": "jest __tests__/api --detectOpenHandles --forceExit",
    "test:integration": "jest __tests__/integration --detectOpenHandles --forceExit",
    "test:watch": "jest --watch --detectOpenHandles",
    "test:coverage": "jest --coverage --detectOpenHandles --forceExit"
  },
  "keywords": ["SIH", "ISOTOPES", "career", "skill-mapping"],
  "author": "ISOTOPES Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "express-validator": "^7.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "mongodb-memory-server": "^9.1.6"
  }
}
